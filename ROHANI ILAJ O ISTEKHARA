<script>
(function () {
  var reduce = false;
  try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  // Planet highlight cycles through the seven planets.
  var pl = [].slice.call(document.querySelectorAll('.pl'));
  var k = 0;
  function tick() {
    pl.forEach(function (p, i) { p.classList.toggle('on', i === k); });
    k = (k + 1) % pl.length;
  }
  tick();
  if (!reduce) setInterval(tick, 2200);

  // Starfield.
  var c = document.getElementById('sky');
  if (!c || !c.getContext) return;
  var ctx = c.getContext('2d');
  var stars = [], w = 0, h = 0, dpr = 1, last = 0, raf = 0;
  function build() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth; h = window.innerHeight;
    c.width = Math.round(w * dpr); c.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var n = Math.min(130, Math.round(w * h / 9500));
    stars = [];
    for (var i = 0; i < n; i++) {
      stars.push({ x: Math.random() * w, y: Math.random() * h, r: .4 + Math.random() * 1.1, a: .25 + Math.random() * .5, s: .6 + Math.random() * 1.6, p: Math.random() * 6.28, g: Math.random() < .18 });
    }
  }
  function draw(t) {
    ctx.clearRect(0, 0, w, h);
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      var a = s.a * (reduce ? 1 : (.65 + .35 * Math.sin(t / 1000 * s.s + s.p)));
      ctx.globalAlpha = a;
      ctx.fillStyle = s.g ? '#F6DDA0' : '#DDE2FF';
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, 6.2832); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }
  function loop(t) {
    raf = requestAnimationFrame(loop);
    if (t - last < 60) return;
    last = t; draw(t);
  }
  build(); draw(0);
  if (!reduce) raf = requestAnimationFrame(loop);
  var rt;
  window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { build(); draw(last); }, 150); });
  document.addEventListener('visibilitychange', function () {
    if (reduce) return;
    if (document.hidden) cancelAnimationFrame(raf); else raf = requestAnimationFrame(loop);
  });
})();
</script>

