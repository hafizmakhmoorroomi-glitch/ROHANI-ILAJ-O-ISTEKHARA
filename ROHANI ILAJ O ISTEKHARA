/* Layout: one night-sky page. Hero pairs the headline with a seven-planet orbit (the app's علم الساعات), then feature cards, a gold-edged download panel with install steps and troubleshooting, a video link, and a mobile download dock. */
:root {
  --ink: #070B24;
  --night: #0D1237;
  --panel: #141A4D;
  --panel-2: #1C2468;
  --line: rgba(227, 181, 92, .28);
  --line-soft: rgba(238, 240, 251, .13);
  --gold: #E3B55C;
  --gold-soft: #F6DDA0;
  --text: #EEF0FB;
  --muted: #B6BCDF;
  --on-gold: #1B1400;
  --font: "Jameel", "Noto Nastaliq Urdu", "Jameel Noori Nastaleeq", "Noto Naskh Arabic", serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background:
    radial-gradient(900px 560px at 80% 0%, rgba(227, 181, 92, .17), transparent 70%) no-repeat,
    radial-gradient(760px 640px at 8% 14%, rgba(92, 106, 224, .30), transparent 70%) no-repeat,
    var(--ink);
  color: var(--text);
  font-family: var(--font);
  font-weight: 400;
  font-synthesis: none;
  font-size: 1.4rem;
  line-height: 1.9;
  direction: rtl;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0;
}
a { color: inherit; }
h1, h2, h3, p, ul, ol { margin: 0; }
:focus-visible { outline: 3px solid var(--gold-soft); outline-offset: 4px; border-radius: 8px; }
#sky { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.page { position: relative; z-index: 1; max-width: 1120px; margin-inline: auto; }

/* header */
header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font-size: 1.9rem; line-height: 2; }
.brand svg { width: 36px; height: 36px; flex: none; }
.nav { display: flex; align-items: center; gap: 28px; font-size: 1.3rem; }
.nav a.plain { text-decoration: none; color: var(--muted); }
.nav a.plain:hover { color: var(--gold-soft); }

/* buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 12px;
  padding: 8px 34px 14px; border-radius: 999px; text-decoration: none;
  font-size: 1.45rem; line-height: 1.9;
  background: linear-gradient(180deg, var(--gold-soft), var(--gold));
  color: var(--on-gold);
  border: 1.5px solid var(--gold);
  box-shadow: 0 10px 30px -10px rgba(227, 181, 92, .55);
  transition: transform .18s ease, box-shadow .18s ease;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -10px rgba(227, 181, 92, .7); }
.btn svg { width: 22px; height: 22px; flex: none; }
.btn.ghost { background: transparent; color: var(--text); border-color: var(--line-soft); box-shadow: none; }
.btn.ghost:hover { border-color: var(--gold); color: var(--gold-soft); }
.btn.sm { padding: 4px 24px 9px; font-size: 1.25rem; }

/* hero */
.hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; align-items: center; padding-block: 24px 36px; }
.eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--gold); font-size: 1.3rem; }
.orn { width: 18px; height: 18px; flex: none; }
h1 { font-size: clamp(2.7rem, 7.4vw, 4.6rem); line-height: 1.8; margin-block: 4px 6px; text-wrap: balance; }
h1 .gold { color: var(--gold); display: block; }
.lead { font-size: 1.55rem; line-height: 2; color: var(--muted); max-width: 30em; margin-bottom: 26px; }
.cta { display: flex; flex-wrap: wrap; gap: 14px; }
.orbit { width: 100%; max-width: 460px; justify-self: center; }
.orbit svg { width: 100%; height: auto; display: block; overflow: visible; }
.ring { fill: none; stroke: var(--line-soft); stroke-width: 1.4; }
.ring.dash { stroke: var(--line); stroke-dasharray: 2 9; stroke-linecap: round; transform-origin: 200px 200px; animation: spin 120s linear infinite; }
.pl .dot { fill: var(--gold); opacity: .6; transform-box: fill-box; transform-origin: center; transition: transform .5s ease, opacity .5s ease, fill .5s ease; }
.pl .halo { fill: var(--gold); opacity: 0; transition: opacity .5s ease; }
.pl text { fill: var(--muted); font-family: var(--font); font-size: 25px; text-anchor: middle; transition: fill .5s ease; }
.pl.on .dot { opacity: 1; fill: var(--gold-soft); transform: scale(1.45); }
.pl.on .halo { opacity: .28; }
.pl.on text { fill: var(--gold-soft); }
@keyframes spin { to { transform: rotate(360deg); } }

/* sections */
section { padding-block: 44px; }
.head { margin-bottom: 30px; }
h2 { font-size: clamp(2.2rem, 5.2vw, 3.2rem); line-height: 1.95; text-wrap: balance; }
.sub { color: var(--muted); max-width: 34em; font-size: 1.4rem; }

.cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.card { background: linear-gradient(160deg, rgba(28, 36, 104, .72), rgba(20, 26, 77, .72)); border: 1px solid var(--line-soft); border-radius: 22px; padding: 26px 24px 18px; transition: border-color .2s ease, transform .2s ease; }
.card:hover { border-color: var(--gold); transform: translateY(-3px); }
.ico { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: var(--gold-soft); background: radial-gradient(circle at 30% 25%, rgba(227, 181, 92, .30), rgba(227, 181, 92, .06)); border: 1px solid var(--line); margin-bottom: 8px; }
.ico svg { width: 28px; height: 28px; }
.card h3 { font-size: 1.95rem; line-height: 2; }
.card p { color: var(--muted); font-size: 1.3rem; line-height: 1.95; }

/* download */
.panel { background: linear-gradient(150deg, var(--panel-2), var(--panel) 60%, var(--night)); border: 1px solid var(--line); border-radius: 30px; padding: clamp(26px, 5vw, 54px); box-shadow: 0 30px 80px -40px rgba(227, 181, 92, .35); }
.panel-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
.panel p.t { color: var(--muted); margin-bottom: 22px; }
.alt { margin-top: 16px; font-size: 1.25rem; color: var(--muted); }
.alt a { color: var(--gold-soft); text-underline-offset: 6px; }
.steps { list-style: none; padding: 0; display: grid; gap: 14px; counter-reset: s; }
.steps li { counter-increment: s; display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 16px; align-items: start; font-size: 1.35rem; line-height: 1.95; }
.steps li::before { content: counter(s); width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--gold); color: var(--gold-soft); display: grid; place-items: center; font-size: 1.1rem; line-height: 1; padding-top: 4px; font-family: system-ui, sans-serif; }
.faq { margin-top: 36px; border-top: 1px solid var(--line-soft); }
.faq details { border-bottom: 1px solid var(--line-soft); }
.faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 8px; font-size: 1.4rem; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: ""; width: 10px; height: 10px; border-inline-end: 2px solid var(--gold); border-bottom: 2px solid var(--gold); transform: rotate(45deg); transition: transform .2s ease; flex: none; margin-inline-end: 6px; }
.faq details[open] summary::after { transform: rotate(-135deg); }
.faq details p { color: var(--muted); font-size: 1.3rem; padding-bottom: 14px; }

/* video */
.video { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px; border: 1px solid var(--line-soft); border-radius: 24px; padding: 26px 30px; background: rgba(13, 18, 55, .6); }
.video h2 { font-size: 2.1rem; }
.video p { color: var(--muted); font-size: 1.3rem; }

footer { padding-block: 44px 56px; text-align: center; color: var(--muted); font-size: 1.3rem; }
footer .dua { color: var(--gold-soft); font-size: 1.6rem; margin-bottom: 4px; }
footer .orn { margin: 0 auto 8px; display: block; }

/* mobile dock */
.dock { display: none; }

@media (max-width: 880px) {
  .hero { grid-template-columns: minmax(0, 1fr); padding-top: 12px; }
  .orbit { max-width: 360px; order: 2; }
  .cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .panel-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .nav a.plain { display: none; }
}
@media (max-width: 560px) {
  body { font-size: 1.3rem; padding-bottom: 96px; }
  .lead { font-size: 1.45rem; }
  .cards { grid-template-columns: minmax(0, 1fr); }
  .cta .btn { flex: 1 1 100%; }
  .nav { display: none; }
  .dock {
    display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 5;
    padding: 8px max(16px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
    background: rgba(7, 11, 36, .92); border-top: 1px solid var(--line);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .dock .btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .ring.dash { animation: none; }
  .btn, .card, .pl .dot, .pl .halo, .pl text, .faq summary::after { transition: none; }
}
</style>

